<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Weather (Stage 4) and connectivity status (Control Center). Nothing personal leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Lets "Uninstall" in the app menu open the system uninstall dialog (needed since API 28).
         The user still confirms every uninstall. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Control Center: Bluetooth on/off. A normal, install-time permission on Android 11 and
         lower; from Android 12 reading on/off needs none. KS never asks for BLUETOOTH_CONNECT. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Optional Apps / Other storage split. Never requested at runtime: the user may grant
         Usage access in Android settings from the Memory & storage panel. Off by default. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Renewal reminders (Stage 5). Asked for on Android 13+ only when the user turns
         reminders on in Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- In-app updates (Stage 6c): installs KS's own verified release through PackageInstaller.
         Android asks the user to allow it and to confirm every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- ACCESS_WIFI_STATE would otherwise imply Wi-Fi is required and hide the app from
         Ethernet-only TVs. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!-- BLUETOOTH would otherwise imply Bluetooth is required. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Package visibility (API 30+). QUERY_ALL_PACKAGES is deliberately not requested. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Settings › Wallpaper shows "Choose a picture" only if a document picker exists. -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="image/*" />
        </intent>
        <!-- Control Center hides the Screensaver tile unless one of these exists. -->
        <package android:name="com.android.systemui" />
        <intent>
            <action android:name="android.settings.DREAM_SETTINGS" />
        </intent>
    </queries>

    <!-- No backup or device transfer: names and subscriptions stay on this device. -->
    <application
        android:name=".KsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KsLauncher">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name_short"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">

            <!-- App mode (specs/app-mode.md): KS is opened from the TV's own launcher.
                 MAIN + LEANBACK_LAUNCHER only. Never add HOME or DEFAULT here. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager starts on demand (KsApplication is its Configuration.Provider), not at
             every app start. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
